# Gmail credentials are server only; disabled until access/compliance review.
RELAY_ENABLE_GMAIL=false
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_CALLBACK_URL=
GMAIL_CREDENTIAL_ENCRYPTION_KEY=
GMAIL_ACCESS_REVIEWED=false
