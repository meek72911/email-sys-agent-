NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server only. Leave blank until the live-AI quota and access controls are ready.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna
# Background jobs: server-only values, configure later.
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=
SUPABASE_SERVICE_ROLE_KEY=
